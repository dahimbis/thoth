# ═══════════════════════════════════════════════
# Thoth — Autonomous LMS Agent Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Student Profile ────────────────────────────
# Your personal details — used to auto-fill forms,
# name assignment files, and identify yourself.
STUDENT_FIRST_NAME=
STUDENT_LAST_NAME=
STUDENT_EMAIL=
STUDENT_ID=
# Optional
STUDENT_PHONE=
STUDENT_MAJOR=
STUDENT_YEAR=

# ── Brightspace (D2L) ──────────────────────────
BRIGHTSPACE_BASE_URL=https://brightspace.nyu.edu
BRIGHTSPACE_USERNAME=
BRIGHTSPACE_PASSWORD=
# Optional: TOTP secret for 2FA (base32-encoded)
BRIGHTSPACE_TOTP_SECRET=

# ── AI Providers ───────────────────────────────
# Portkey gateway (primary — routes to Claude, GPT, etc.)
PORTKEY_GATEWAY_URL=https://ai-gateway.apps.cloud.rt.nyu.edu/v1
PORTKEY_API_KEY=

# Direct provider keys (fallback — used if Portkey is down)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Search APIs ────────────────────────────────
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# ── Gmail (optional — for email monitoring) ────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Institution ────────────────────────────────
INSTITUTION_DOMAIN=nyu.edu
INSTITUTION_NAME=New York University

# ── Agent Behavior ─────────────────────────────
# Auto-submit quizzes when timer is critical (seconds)
QUIZ_AUTO_SUBMIT_THRESHOLD=30
# Email polling interval (minutes)
EMAIL_POLL_INTERVAL=15
# Browser headless mode (true/false)
BROWSER_HEADLESS=true
